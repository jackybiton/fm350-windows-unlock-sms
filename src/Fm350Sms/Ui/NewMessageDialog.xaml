<Window x:Class="Fm350Sms.NewMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="הודעה חדשה"
        Width="400" Height="460" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="14" Background="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=QueryBox}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="מספר או שם איש קשר" Margin="0,0,0,4" />
        <TextBox DockPanel.Dock="Top" x:Name="QueryBox" Padding="6,4" TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="המשך" MinWidth="80" Padding="12,4" IsDefault="True" IsEnabled="False" Click="OnOk" />
            <Button Content="ביטול" MinWidth="80" Padding="12,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="Results" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnResultDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding NumberDisplay}" FlowDirection="LeftToRight" Margin="8,0,0,0"
                                   Foreground="{StaticResource SubtleBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
